    local submitDelay = getCodeSubmitDelay()

    setRedeemStatus("AUTO: отправка через " .. string.format("%.1f", submitDelay) .. " сек.")



    task.delay(submitDelay, function()

        if not alive() or myDelivery ~= deliveryToken then

            return

        end



        if not textBox.Parent then

            setRedeemStatus("TextBox исчез перед отправкой.")

            return

        end



        local released = pcall(function()

            textBox:ReleaseFocus(true)

        end)



        if released then

            print("[SAB HUB] AUTO SENT:", code)

            setRedeemStatus("AUTO: код отправлен.")

