local function registerSecretAnnouncement()

    if not alive() then

        return

    end



    local now = os.clock()

    if now - lastSecretAnnouncementAt.brainrot < 2 then

        return

    end

    lastSecretAnnouncementAt.brainrot = now



    local entry = {

        time = os.date("%H:%M:%S"),

        name = "Определяю Brainrot...",

        identified = false

    }

    table.insert(secretEntries, 1, entry)

    while #secretEntries > 20 do

        table.remove(secretEntries)

    end

    renderSecretEntries()

    showSecretToast(entry)



    task.spawn(function()
        local candidates = {}
        local candidateCount = 0
        local deadline = now + SECRET_PROMPT_POST_WINDOW + 0.25

        -- Do not stop at the first prompt. Ritual previews and the real conveyor
        -- Brainrot can appear close together, so observe the entire spawn window.
        while alive() and os.clock() < deadline do
            for prompt, addedAt in pairs(promptArrivalTimes) do
                local closeToAnnouncement = addedAt >= now - SECRET_PROMPT_PRE_WINDOW
                    and addedAt <= now + SECRET_PROMPT_POST_WINDOW

                if closeToAnnouncement
                    and not claimedSecretPrompts[prompt]
                    and prompt.Parent
                    and isBrainrotPurchasePrompt(prompt) then

                    local displayName = getPromptDisplayName(prompt)
                    if displayName then
                        local position = getPromptWorldPosition(prompt)
                        local candidate = candidates[prompt]

                        if not candidate then
                            candidateCount += 1
                            candidates[prompt] = {
                                addedAt = addedAt,
                                name = displayName,
                                firstPosition = position,
                                lastPosition = position,
                                travelDistance = 0
                            }
                        else
                            candidate.name = displayName
                            if position and candidate.firstPosition then
                                candidate.lastPosition = position
                                candidate.travelDistance = (position - candidate.firstPosition).Magnitude
                            elseif position then
                                candidate.firstPosition = position
                                candidate.lastPosition = position
                            end
                        end
                    end
                end
            end
            task.wait(0.1)
        end

        local bestMovingPrompt = nil
        local bestMovingDistance = -1
        local bestMovingTimeDistance = math.huge
        local fallbackPrompt = nil
        local fallbackTimeDistance = math.huge

        for prompt, candidate in pairs(candidates) do
            if prompt.Parent and not claimedSecretPrompts[prompt] then
                local timeDistance = math.abs(candidate.addedAt - now)
                if candidate.travelDistance >= SECRET_CONVEYOR_MOVE_THRESHOLD then
                    if candidate.travelDistance > bestMovingDistance
                        or (candidate.travelDistance == bestMovingDistance and timeDistance < bestMovingTimeDistance) then
                        bestMovingPrompt = prompt
                        bestMovingDistance = candidate.travelDistance
                        bestMovingTimeDistance = timeDistance
                    end
                elseif timeDistance < fallbackTimeDistance then
                    fallbackPrompt = prompt
                    fallbackTimeDistance = timeDistance
                end
            end
        end

        -- Prefer the model that travelled along the conveyor. Use timing-only
        -- fallback only when exactly one fresh candidate exists; with multiple
        -- candidates, a stationary preview must not be reported as the spawned item.
        local bestPrompt = bestMovingPrompt
        if not bestPrompt and candidateCount == 1 then
            bestPrompt = fallbackPrompt
        end
        if bestPrompt then
            claimedSecretPrompts[bestPrompt] = true
            local candidate = candidates[bestPrompt]
            entry.name = candidate and candidate.name or getPromptDisplayName(bestPrompt) or "Название не найдено"
            entry.identified = candidate ~= nil or entry.name ~= "Название не найдено"
        else
            entry.name = "Название не найдено"
            entry.identified = false
        end

        renderSecretEntries()
        updateSecretToastEntry(entry)

    end)

end



