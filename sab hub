-- Popup notifications default to ON and retain the user's choice across reloads.

-- Disabling popups never disables Secret Spawn history collection.

local notificationsEnabled = ENV.__SAB_SECRET_NOTIFICATIONS ~= false



local secretToastToken = 0

local secretToastTweens = {}

local activeSecretToastEntry = nil



local function cancelSecretToastTweens()

    for _, tween in ipairs(secretToastTweens) do

        pcall(function()

            tween:Cancel()

        end)

    end

    table.clear(secretToastTweens)

end



local function playSecretToastTween(object, duration, properties)

    local tween = TweenService:Create(

        object,

        TweenInfo.new(duration, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),

        properties

    )

    table.insert(secretToastTweens, tween)

    tween:Play()

    return tween

end



local function getSecretToastName(entry)

    if entry.identified then

        return tostring(entry.name)

    elseif entry.name == "Название не найдено" then

        return "НАЗВАНИЕ НЕ НАЙДЕНО"

    end

    return "ОПРЕДЕЛЯЮ НАЗВАНИЕ..."

end



local function updateSecretToastEntry(entry)

    if not secretToast.Visible or activeSecretToastEntry ~= entry then

        return

    end

    secretToastMessage.Text = getSecretToastName(entry)

end



local function showSecretToast(entry)

    if not notificationsEnabled then

        return

    end



    secretToastToken += 1

    local thisToken = secretToastToken

    activeSecretToastEntry = entry

    cancelSecretToastTweens()



    local camera = workspace.CurrentCamera

    local viewport = camera and camera.ViewportSize or Vector2.new(800, 600)

    secretToastScale.Scale = math.clamp((viewport.X - 28) / 390, 0.68, 1)



    secretToastTitle.Text = entry.toastTitle or "✦  SECRET SPAWNED!"

    secretToastMessage.Text = getSecretToastName(entry)



    secretToast.Visible = true

    secretToast.Position = UDim2.new(1, -18, 1, 130)

    secretToast.BackgroundTransparency = 1

    secretToastStroke.Transparency = 1

    secretToastAccent.BackgroundTransparency = 1

    secretToastTitle.TextTransparency = 1

    secretToastMessage.TextTransparency = 1



    playSecretToastTween(secretToast, 0.28, {

        Position = UDim2.new(1, -18, 1, -18),

        BackgroundTransparency = 0.06

    })

    playSecretToastTween(secretToastStroke, 0.28, { Transparency = 0.08 })

    playSecretToastTween(secretToastAccent, 0.28, { BackgroundTransparency = 0 })

    playSecretToastTween(secretToastTitle, 0.28, { TextTransparency = 0 })

    playSecretToastTween(secretToastMessage, 0.28, { TextTransparency = 0 })



    task.delay(5.5, function()

        if not alive() or thisToken ~= secretToastToken then

            return

        end



        cancelSecretToastTweens()

        local outTween = playSecretToastTween(secretToast, 0.25, {

            Position = UDim2.new(1, -18, 1, 130),

            BackgroundTransparency = 1

        })

        playSecretToastTween(secretToastStroke, 0.25, { Transparency = 1 })

        playSecretToastTween(secretToastAccent, 0.25, { BackgroundTransparency = 1 })

        playSecretToastTween(secretToastTitle, 0.25, { TextTransparency = 1 })

        playSecretToastTween(secretToastMessage, 0.25, { TextTransparency = 1 })



        outTween.Completed:Wait()

        if alive() and thisToken == secretToastToken then

            secretToast.Visible = false

            activeSecretToastEntry = nil

            cancelSecretToastTweens()

        end

    end)

end



local function positionSecretPanel()

    local camera = workspace.CurrentCamera

    local viewport = camera and camera.ViewportSize or Vector2.new(800, 600)

    local left = frame.AbsolutePosition.X

    local right = left + frame.AbsoluteSize.X

    local top = frame.AbsolutePosition.Y

    local bottom = top + frame.AbsoluteSize.Y

    local panelWidth = secretPanel.AbsoluteSize.X

    local panelHeight = secretPanel.AbsoluteSize.Y



    if viewport.X - right >= panelWidth + 8 then

        secretPanel.Position = UDim2.new(1, 8, 0, 42)

    elseif left >= panelWidth + 8 then

        secretPanel.Position = UDim2.new(0, -secretPanel.Size.X.Offset - 8, 0, 42)

    elseif viewport.Y - bottom >= panelHeight + 8 then

        secretPanel.Position = UDim2.new(0, 26, 1, 8)

    else

        -- On very small screens, open as an overlay inside the main panel.

        secretPanel.Position = UDim2.fromOffset(26, 42)

    end

end



