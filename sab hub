    name = name:gsub("^%s+", ""):gsub("%s+$", "")

    if name == "" then
        local model = getPromptModel(prompt)
        name = model and tostring(model.Name) or ""
    end

    local lowered = name:lower()
    if lowered == "brainrot" or lowered == "secret brainrot" or lowered == "purchase" then
        return nil
    end
    return name ~= "" and name or nil
end

-- In the 1x1x1x1 ritual a preview may be visible before the actual conveyor item.
-- Read the owning model's pivot so we can distinguish a stationary preview from
-- the Brainrot that physically travels along the conveyor.
local function getPromptWorldPosition(prompt)
    local model = getPromptModel(prompt)
    if model then
        local ok, pivot = pcall(function()
            return model:GetPivot()
        end)
        if ok and pivot then
            return pivot.Position
        end
    end

    local parent = prompt and prompt.Parent
    if parent and parent:IsA("BasePart") then
        return parent.Position
    end
    return nil
end

local SECRET_CONVEYOR_MOVE_THRESHOLD = 1.0

local function rememberNewPrompt(prompt, addedAt)

    if not prompt:IsA("ProximityPrompt") then

        return

    end



    -- Some games fill ActionText/ObjectText just after parenting the prompt.

    local function tryRemember()

        if alive() and prompt.Parent and not promptArrivalTimes[prompt]

            and isBrainrotPurchasePrompt(prompt) then

            promptArrivalTimes[prompt] = addedAt

        end

    end



    for _, delaySeconds in ipairs({ 0.08, 0.35, 0.9, 1.5 }) do

        task.delay(delaySeconds, tryRemember)

    end

end



