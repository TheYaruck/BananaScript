local function findRedeemBox()
    local codesGui = playerGui:FindFirstChild("Codes")
    if not codesGui then
        return nil
    end

    local innerCodes = codesGui:FindFirstChild("Codes")
    local searchRoot = innerCodes or codesGui
    local redeemFrame = searchRoot:FindFirstChild("CodeRedeem", true)

    if not redeemFrame then
        return nil
    end

    local textBox = redeemFrame:FindFirstChild("TextBox", true)
    if textBox and textBox:IsA("TextBox") then
        return textBox
    end

    return nil
end

local function deliverCode(code)
    deliveryToken += 1
    local myDelivery = deliveryToken
    local textBox = findRedeemBox()

    if not textBox then
        setRedeemStatus("Redeem TextBox не найден.")
        warn("[SAB HUB] Redeem TextBox not found")
        return
    end

    local success, err = pcall(function()
        textBox:CaptureFocus()
        textBox.Text = code
    end)

    if not success then
        setRedeemStatus("Ошибка вставки: " .. tostring(err))
        return
    end

    setRedeemStatus("AUTO: отправляю " .. code)

    task.defer(function()
        if not alive() or myDelivery ~= deliveryToken then
            return
        end

        if not textBox.Parent then
            setRedeemStatus("TextBox исчез перед отправкой.")
            return
        end

        local released = pcall(function()
            textBox:ReleaseFocus(true)
        end)

        if released then
            print("[SAB HUB] AUTO SENT:", code)
            setRedeemStatus("AUTO: код отправлен.")
        else
            setRedeemStatus("Не удалось нажать Enter.")
        end
    end)
end

local function cleanFragment(raw)
    raw = tostring(raw or "")
    raw = raw:gsub("<.->", "")
    raw = raw:lower()
    return raw:gsub("[^%w_%-]", "")
end

local function startCollection()
    collectionToken += 1
    clearFragments()
    collecting = true
    setRedeemStatus("Сбор начат. Жду части кода...")
    updateFinishButton()
    print("[SAB HUB] Code collection started")
end

local finishCollection

finishCollection = function(reason)
    if not collecting or #fragments == 0 then
        return
    end

    local code = table.concat(fragments)
    collecting = false
    clearFragments()
    collectionToken += 1
    updateFinishButton()

    if code == "" then
        setRedeemStatus("Пустой код.")
        return
    end

    print("[SAB HUB] COMPLETE CODE:", code)
    print("[SAB HUB] Finish reason:", reason)
    deliverCode(code)
end

local function addFragment(raw)
    if not collecting then
        return
    end

    local fragment = cleanFragment(raw)
    if fragment == "" then
        return
    end

    table.insert(fragments, fragment)
    print("[SAB HUB] Fragment " .. tostring(#fragments) .. ": " .. fragment)
    setRedeemStatus(
        "Собрано частей: " .. tostring(#fragments)
        .. "\nЖду продолжение или FINISH CODE."
    )
    updateFinishButton()

    if fragment:match("%d+$") then
        finishCollection("instant numeric ending")
    end
end

local function findStartMarker(raw)
    local lower = tostring(raw or ""):lower()
    local useStart, useEnd = lower:find("use%s+code")
    local isStart, isEnd = lower:find("code%s+is")

    if useStart and isStart then
        if useStart <= isStart then
            return useEnd
        else
            return isEnd
        end
    end

    if useStart then
        return useEnd
    end

    if isStart then
        return isEnd
    end

    return nil
end

local function processNotification(rawText)
    if not alive() then
        return
    end

    local raw = tostring(rawText or "")
    raw = raw:gsub("<.->", "")
    local markerEnd = findStartMarker(raw)

    if markerEnd then
        print("[SAB HUB] Start marker detected:", raw)
        fallbackArmed = false
        updateRKDButton()
        startCollection()

        local tail = raw:sub(markerEnd + 1)
        if tail ~= "" then
            addFragment(tail)
        end
        return
    end

    if collecting then
        addFragment(raw)
        return
    end

    if fallbackArmed then
        fallbackArmed = false
        updateRKDButton()
        print("[SAB HUB] Fallback activated:", raw)
        startCollection()
        addFragment(raw)
    end
end

local function watchLabel(label)
    if not label
    or not label:IsA("TextLabel")
    or label.Name ~= "Template"
    or watchedLabels[label] then
        return
    end

    watchedLabels[label] = true

    local function inspect()
        if not alive() or not label.Parent then
            return
        end

        local currentText = label.Text
        if not currentText or currentText == "" then
            return
        end

        if lastLabelText[label] == currentText then
            return
        end

        lastLabelText[label] = currentText
        processNotification(currentText)
    end

    connect(label:GetPropertyChangedSignal("Text"), inspect)
    task.delay(0.03, inspect)
end

local function setupNotificationWatcher()
    local root = playerGui:WaitForChild("TopNotification", 25)

    if not alive() then
        return
    end

    if not root then
        setRedeemStatus("TopNotification не найден.")
        warn("[SAB HUB] TopNotification not found")
        return
    end

    connect(root.DescendantAdded, function(object)
        watchLabel(object)
    end)

    for _, object in ipairs(root:GetDescendants()) do
        watchLabel(object)
    end

    setRedeemStatus("Готово. Ожидаю объявление...")
    print("[SAB HUB] Notification watcher ready")
end

