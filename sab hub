local function getAutoBuyDelay()
    local ms = tonumber(msBox.Text)
    if not ms then
        ms = 100
    end
    if ms < 1 then
        ms = 1
    end
    return ms / 1000
end

local function isBrainrotPurchasePrompt(prompt)
    if not prompt
    or not prompt:IsA("ProximityPrompt")
    or not prompt.Parent then
        return false
    end

    if prompt.ActionText ~= "Purchase" then
        return false
    end

    local objectText = tostring(prompt.ObjectText or "")
    local hasPrice = objectText:match("%$[%d,%.]+[KMBkmb]?$")

    if not hasPrice then
        return false
    end

    local attachment = prompt.Parent
    if not attachment:IsA("Attachment") then
        return false
    end

    local part = attachment.Parent
    if not part or not part:IsA("BasePart") then
        return false
    end

    local model = part.Parent
    if not model or not model:IsA("Model") then
        return false
    end

    return model.Parent == workspace
end

local function startPromptWorker(prompt)
    if promptWorkers[prompt] then
        return
    end

    local token = {}
    promptWorkers[prompt] = token

    task.spawn(function()
        while alive()
        and autoBuyActive
        and promptWorkers[prompt] == token
        and visiblePrompts[prompt]
        and prompt.Parent
        and prompt.Enabled do

            if not isBrainrotPurchasePrompt(prompt) then
                break
            end

            pcall(function()
                prompt.HoldDuration = 0
                prompt:InputHoldBegin()
                prompt:InputHoldEnd()
            end)

            task.wait(getAutoBuyDelay())
        end

        if promptWorkers[prompt] == token then
            promptWorkers[prompt] = nil
        end
    end)
end

connect(ProximityPromptService.PromptShown, function(prompt)
    if isBrainrotPurchasePrompt(prompt) then
        visiblePrompts[prompt] = true
        autoBuyPageStatus.Text = "Найден Brainrot: " .. tostring(prompt.ObjectText)

        if autoBuyActive then
            startPromptWorker(prompt)
        end
    end
end)

connect(ProximityPromptService.PromptHidden, function(prompt)
