local PAGE_HEIGHTS = {

    Redeem = UserInputService.TouchEnabled and 350 or 260,

    AutoBuy = UserInputService.TouchEnabled and 350 or 260,

    SammyScanner = UserInputService.TouchEnabled and 390 or 305

}



local function applyPageHeight(name)

    local newHeight = PAGE_HEIGHTS[name] or 305

    local oldHeight = frame.Size.Y.Offset

    if oldHeight ~= newHeight then

        frame.Size = UDim2.fromOffset(UserInputService.TouchEnabled and 340 or 300, newHeight)

        -- Keep the panel centered around its current position, even after dragging.

        frame.Position = UDim2.new(

            frame.Position.X.Scale,

            frame.Position.X.Offset,

            frame.Position.Y.Scale,

            frame.Position.Y.Offset + (oldHeight - newHeight) / 2

        )

    end

end



local function showPage(name)

    activePage = name

    applyPageHeight(name)

    for pageName, page in pairs(pages) do

        page.Visible = pageName == name

    end

    for tabName, button in pairs(tabs) do

        local selected = tabName == name

        button.BackgroundColor3 = selected and YELLOW or PANEL_LIGHT

        button.TextColor3 = selected and BLACK or WHITE

    end

end

local function createTab(name, label, index)

    -- Use proportional sizing so all three tabs remain fully visible on
    -- desktop and touch layouts, including scaled/narrow viewports.
    local button = makeButton(

        tabBar,

        label,

        UDim2.new((index - 1) / 3, (index - 1) * 2, 0, 0),

        UDim2.new(1 / 3, -4, 1, 0),

        PANEL_LIGHT,

        WHITE,

        10

    )

    button.Name = "Tab_" .. name
    button.ZIndex = 11

    tabs[name] = button

    connect(button.Activated, function()

        showPage(name)

    end)

    return button

end

