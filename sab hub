local function watchChatText(object)

    if watchedChatText[object]

        or not (object:IsA("TextLabel") or object:IsA("TextButton"))

        or not isInsideChatGui(object) then

        return

    end

    watchedChatText[object] = true



    local lastText = nil

    local function inspect()

        if not alive() or not object.Parent then

            return

        end

        local currentText = object.Text

        if currentText ~= lastText then

            lastText = currentText

            inspectSecretAnnouncement(currentText)

        end

    end



    connect(object:GetPropertyChangedSignal("Text"), inspect)

    task.defer(inspect)

end



