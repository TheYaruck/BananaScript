        if armedAtDetection and not sammyCaptureArmed then
            return
        end
        if sourceLabel and (not sourceLabel.Parent or sourceLabel.Text ~= rawText) then
            return
        end

        if setSammyMessage(rawText, "Сообщение захвачено целиком. Можно копировать." ) then
            if armedAtDetection then
                sammyCaptureArmed = false
                updateSammyCaptureButton()
