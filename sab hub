local startPromptWorker

local stopPromptWorkers



stopPromptWorkers = function()

    -- Clearing the token makes any running worker exit on its next loop check.

    for prompt in pairs(promptWorkers) do

        promptWorkers[prompt] = nil

    end

end



startPromptWorker = function(prompt)

    if not alive()

        or not autoBuyActive

        or promptWorkers[prompt]

        or not visiblePrompts[prompt]

        or not isBrainrotPurchasePrompt(prompt) then

        return false

    end



    local token = {}

    promptWorkers[prompt] = token



    task.spawn(function()

        while alive()

            and autoBuyActive

            and promptWorkers[prompt] == token

            and visiblePrompts[prompt]

            and prompt.Parent

            and prompt.Enabled

            and isBrainrotPurchasePrompt(prompt) do



            local ok, err = pcall(function()

                -- Legacy behavior: make this prompt instant and trigger it.

                prompt.HoldDuration = 0

                prompt:InputHoldBegin()

                prompt:InputHoldEnd()

            end)



            if not ok then

                if alive() and autoBuyPageStatus.Parent then

                    autoBuyPageStatus.Text = "Ошибка Purchase: " .. tostring(err)

                end

                break

            end



            if alive() and autoBuyPageStatus.Parent then

                autoBuyPageStatus.Text = "Auto Buy: " .. tostring(prompt.ObjectText)

            end



            task.wait(getAutoBuyDelay())

        end



        if promptWorkers[prompt] == token then

            promptWorkers[prompt] = nil

        end

    end)



    return true

end



