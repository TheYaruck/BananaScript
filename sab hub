    latestTopNotificationText = rawText
    local armedAtDetection = sammyCaptureArmed
    if not armedAtDetection and not isSammyRelatedMessage(rawText) then
        return
    end

    -- Let the UI finish assigning the full Text value before storing it.
    task.delay(0.08, function()
        if not alive() then
            return
