        .. (digEnabled and "ON" or "OFF")
end

local function createDigMarker(object, category)
    local anchor = getAnchor(object)
    if not anchor then
        return
    end

    local data = folderNames[category]
    if not data then
        return
    end

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "SAB_HUB_DigMarker"
    billboard.Adornee = anchor
    billboard.Size = UDim2.fromOffset(190, 48)
    billboard.StudsOffset = Vector3.new(0, 2, 0)
    billboard.AlwaysOnTop = true
    billboard.Enabled = digEnabled
    billboard.Parent = gui

    local label = create("TextLabel", {
        Size = UDim2.fromScale(1, 1),
        BackgroundColor3 = BLACK,
        BackgroundTransparency = 0.12,
        BorderSizePixel = 0,
        TextColor3 = data.color,
        TextStrokeTransparency = 0.6,
        Font = Enum.Font.GothamBold,
        TextSize = 11,
        TextWrapped = true,
        Text = data.label .. ": " .. object.Name
            .. "\n" .. getPositionText(anchor.Position)
    }, billboard)
    addCorner(label, 6)

    digTargets[object].billboard = billboard
end

local function removeDigTarget(object)
    local data = digTargets[object]
    if not data then
        return
    end

    if data.billboard then
        data.billboard:Destroy()
    end

    if data.connection then
        data.connection:Disconnect()
    end

    digTargets[object] = nil
    updateDigStatus()
end

local function registerDigObject(object, container)
    if digTargets[object] then
        return
    end

    if not object:IsA("Model") and not object:IsA("BasePart") then
        return
    end

    if not getAnchor(object) then
        return
    end

    digTargets[object] = {
        billboard = nil,
        category = container.Name,
        container = container
    }

    createDigMarker(object, container.Name)

    digTargets[object].connection = connect(object.AncestryChanged, function()
        if not object:IsDescendantOf(container) then
            removeDigTarget(object)
        end
    end)

    print(
        "[SAB HUB DIG] Found:",
        container.Name,
        object.Name,
        getPositionText(getAnchor(object).Position)
    )

    updateDigStatus()
end

local function getDigItemRoot(object, container)
    local current = object
    local candidate = nil

    while current and current ~= container do
        if current:IsA("Model") or current:IsA("BasePart") then
            candidate = current
        end

        if current.Parent == container then
            break
        end

        current = current.Parent
    end

    return candidate
end

local function scanDigContainer(container)
    local function scanBranch(object)
        if object:IsA("Model") or object:IsA("BasePart") then
            registerDigObject(object, container)
            return
        end

        for _, child in ipairs(object:GetChildren()) do
            scanBranch(child)
        end
    end

    for _, child in ipairs(container:GetChildren()) do
        scanBranch(child)
    end
end

local function connectDigContainer(container)
    if digContainers[container] then
        return
    end

    digContainers[container] = true
    scanDigContainer(container)

    connect(container.DescendantAdded, function(object)
        local root = getDigItemRoot(object, container)
        if root then
            task.defer(function()
                if alive() and root.Parent then
                    registerDigObject(root, container)
                end
            end)
        end
    end)

    connect(container.AncestryChanged, function()
        if not container:IsDescendantOf(workspace) then
            for object, data in pairs(digTargets) do
                if data.container == container then
                    removeDigTarget(object)
                end
            end
            digContainers[container] = nil
        end
    end)
end

for name in pairs(folderNames) do
    local folder = workspace:FindFirstChild(name)
    if folder then
        connectDigContainer(folder)
    end
end

connect(workspace.ChildAdded, function(object)
    if folderNames[object.Name] then
        task.defer(function()
            if alive() and object.Parent == workspace then
                connectDigContainer(object)
            end
        end)
    end
end)

connect(digToggle.MouseButton1Click, function()
    digEnabled = not digEnabled

    digToggle.Text = digEnabled and "ESP: ON" or "ESP: OFF"
    digToggle.BackgroundColor3 = digEnabled and YELLOW or PANEL_LIGHT
    digToggle.TextColor3 = digEnabled and BLACK or WHITE

    for _, data in pairs(digTargets) do
        if data.billboard then
            data.billboard.Enabled = digEnabled
        end
    end

    updateDigStatus()
end)

connect(digRefresh.MouseButton1Click, function()
    for name in pairs(folderNames) do
        local folder = workspace:FindFirstChild(name)
        if folder then
            connectDigContainer(folder)
            scanDigContainer(folder)
        end
    end
    updateDigStatus()
end)

--// CLEANUP
local function cleanup()
    if not running then
        return
    end

    running = false
    autoBuyActive = false

    for _, connection in ipairs(connections) do
        pcall(function()
            connection:Disconnect()
        end)
    end
    table.clear(connections)

    for object, data in pairs(digTargets) do
        if data.connection then
            pcall(function()
                data.connection:Disconnect()
            end)
        end
        if data.billboard then
            pcall(function()
                data.billboard:Destroy()
            end)
        end
        digTargets[object] = nil
    end

    pcall(function()
        gui:Destroy()
    end)
end

