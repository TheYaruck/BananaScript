local function watchLabel(label)

    if not label

    or not label:IsA("TextLabel")

    or label.Name ~= "Template"

    or watchedLabels[label] then

        return

    end

    watchedLabels[label] = true

    local function inspect()

        if not alive() or not label.Parent then

            return

        end

        local currentText = label.Text

        if not currentText or currentText == "" then

            return

        end

        if lastLabelText[label] == currentText then

            return

        end

        lastLabelText[label] = currentText

        -- Reuse the exact TopNotification source already used by Code and Secret detection.
        -- Sammy Scanner stores the whole current label text as one message.
        queueSammyNotification(currentText, label)

        processNotification(currentText)

        if inspectSecretAnnouncement then

            inspectSecretAnnouncement(currentText)

        end

    end

    connect(label:GetPropertyChangedSignal("Text"), inspect)

    task.delay(0.03, inspect)

end

