-- Money
local function updateMoney()
	local leaderstats = player:FindFirstChild("leaderstats")

	if leaderstats then
		local cash =
			leaderstats:FindFirstChild("Cash")
			or leaderstats:FindFirstChild("Money")
			or leaderstats:FindFirstChild("Brainrot")
			or leaderstats:FindFirstChild("Points")

		if cash then
			local amount = cash.Value
			moneyLabel.Text = "$" .. amount
		end
	end
end

updateMoney()

task.spawn(function()
	while true do
		task.wait(1)
		updateMoney()
	end
end)

