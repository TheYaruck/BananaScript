--==================================================
-- АНИМАЦИИ
--==================================================

local function stopAnimator(animator)

	if not animator then
		return
	end

	-- Останавливаем уже играющие AnimationTrack
	for _, track in ipairs(
		animator:GetPlayingAnimationTracks()
	) do

		pcall(function()
			track:Stop(0)
		end)

	end

	-- Перехватываем новые AnimationTrack
	local connection

	connection = animator.AnimationPlayed:Connect(function(track)

		if animationsOptimized then

			pcall(function()
				track:Stop(0)
			end)

		end
	end)

	table.insert(
		animationConnections,
		connection
	)
end

local function processAnimationObject(object)

	if object:IsA("Animator") then

		stopAnimator(object)

		return
	end

	if object:IsA("Humanoid") then

		local animator =
			object:FindFirstChildOfClass("Animator")

		if animator then
			stopAnimator(animator)
		end

		return
	end

	if object:IsA("AnimationController") then

		local animator =
			object:FindFirstChildOfClass("Animator")

		if animator then
			stopAnimator(animator)
		end
	end
end

--==================================================
-- НОВЫЕ ОБЪЕКТЫ
--==================================================

local function watchNewObject(object)

	if not animationsOptimized then
		return
	end

	if object:IsA("Humanoid")
		or object:IsA("AnimationController")
		or object:IsA("Animator") then

		task.defer(function()

			if animationsOptimized
				and object
				and object.Parent then

				processAnimationObject(object)

			end
		end)
	end
end

local function startAnimationWatcher()

	-- Следим за появлением новых объектов
	local connection =
		workspace.DescendantAdded:Connect(
			watchNewObject
		)

	table.insert(
		animationObjectConnections,
		connection
	)

	-- Следим за персонажами игроков
	local playerConnection =
		Players.PlayerAdded:Connect(function(otherPlayer)

			local characterConnection

			characterConnection =
				otherPlayer.CharacterAdded:Connect(
					function(character)

						if not animationsOptimized then
							return
						end

						task.wait(0.1)

						for _, object in ipairs(
							character:GetDescendants()
						) do

							if object:IsA("Humanoid")
								or object:IsA("AnimationController")
								or object:IsA("Animator") then

								processAnimationObject(object)
							end
						end
					end
				)

			table.insert(
				animationObjectConnections,
				characterConnection
			)
		end)

	table.insert(
		animationObjectConnections,
		playerConnection
	)

	-- Уже существующие игроки
	for _, otherPlayer in ipairs(
		Players:GetPlayers()
	) do

		local characterConnection

		characterConnection =
			otherPlayer.CharacterAdded:Connect(
				function(character)

					if not animationsOptimized then
						return
					end

					task.wait(0.1)

					for _, object in ipairs(
						character:GetDescendants()
					) do

						if object:IsA("Humanoid")
							or object:IsA("AnimationController")
							or object:IsA("Animator") then

							processAnimationObject(object)
						end
					end
				end
			)

		table.insert(
			animationObjectConnections,
			characterConnection
		)
	end
end

--==================================================
-- ВКЛЮЧЕНИЕ АНИМАЦИЙ
--==================================================

local function optimizeAnimations()

	if animationsOptimized then
		return
	end

	animationsOptimized = true

	print("ОПТИМИЗАЦИЯ АНИМАЦИЙ: ВКЛ")

	-- Проверяем весь Workspace
	for _, object in ipairs(
		workspace:GetDescendants()
	) do

		if object:IsA("Humanoid")
			or object:IsA("AnimationController")
			or object:IsA("Animator") then

			processAnimationObject(object)
		end
	end

	-- Проверяем персонажей игроков
	for _, otherPlayer in ipairs(
		Players:GetPlayers()
	) do

		if otherPlayer.Character then

			for _, object in ipairs(
				otherPlayer.Character:GetDescendants()
			) do

				if object:IsA("Humanoid")
					or object:IsA("AnimationController")
					or object:IsA("Animator") then

					processAnimationObject(object)
				end
			end
		end
	end

	-- Начинаем отслеживать новые объекты
	startAnimationWatcher()

	animationButton.Text =
		"🎞️ АНИМАЦИИ: ВКЛ"

	animationButton.BackgroundColor3 =
		Color3.fromRGB(55,85,55)
end

--==================================================
-- ВЫКЛЮЧЕНИЕ АНИМАЦИЙ
--==================================================

local function restoreAnimations()

	animationsOptimized = false

	-- Отключаем все соединения AnimationPlayed
	for _, connection in ipairs(
		animationConnections
	) do

		pcall(function()
			connection:Disconnect()
		end)
	end

	animationConnections = {}

	-- Отключаем наблюдение за новыми объектами
	for _, connection in ipairs(
		animationObjectConnections
	) do

		pcall(function()
			connection:Disconnect()
		end)
	end

	animationObjectConnections = {}

	animationButton.Text =
		"🎞️ АНИМАЦИИ: ВЫКЛ"

	animationButton.BackgroundColor3 =
		Color3.fromRGB(30,30,38)

	print("ОПТИМИЗАЦИЯ АНИМАЦИЙ: ВЫКЛ")
end

animationButton.MouseButton1Click:Connect(function()

	if animationsOptimized then

		restoreAnimations()

	else

