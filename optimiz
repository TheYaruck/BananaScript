--==================================================

local function baseOptimization()

	saveProperty(Lighting, "GlobalShadows")
	Lighting.GlobalShadows = false

	for _, object in ipairs(Lighting:GetDescendants()) do

		if object:IsA("PostEffect") then

			saveProperty(object, "Enabled")
			object.Enabled = false

		end
	end

	for _, object in ipairs(workspace:GetDescendants()) do

		if object:IsA("ParticleEmitter")
			or object:IsA("Trail")
			or object:IsA("Beam")
			or object:IsA("Smoke")
			or object:IsA("Fire")
			or object:IsA("Sparkles") then

			saveProperty(object, "Enabled")
			object.Enabled = false
		end

		if object:IsA("PointLight")
			or object:IsA("SpotLight")
			or object:IsA("SurfaceLight") then

			saveProperty(object, "Enabled")
			object.Enabled = false
		end
	end
end

--==================================================
-- ОПТИМИЗАЦИЯ HIGH
--==================================================

local function highOptimization()

	baseOptimization()

	for _, object in ipairs(workspace:GetDescendants()) do

		if object:IsA("BasePart") then

			saveProperty(object, "Material")
			object.Material = Enum.Material.SmoothPlastic

			saveProperty(object, "CastShadow")
			object.CastShadow = false

			saveProperty(object, "Reflectance")
			object.Reflectance = 0
		end

		if object:IsA("Decal")
			or object:IsA("Texture") then

			saveProperty(object, "Transparency")
			object.Transparency = 1
		end

		if object:IsA("SurfaceAppearance") then

			saveProperty(object, "Enabled")
			object.Enabled = false
		end

		if object:IsA("MeshPart") then

			pcall(function()

				saveProperty(object, "RenderFidelity")

				object.RenderFidelity =
					Enum.RenderFidelity.Performance

			end)
		end
	end
end

--==================================================
-- ОПТИМИЗАЦИЯ ULTRA
--==================================================

local function ultraOptimization()

	highOptimization()

	for _, object in ipairs(workspace:GetDescendants()) do

		if object:IsA("BasePart") then

			local size = object.Size

			local smallest =
				math.min(size.X, size.Y, size.Z)

			if smallest <= 0.2 then

				saveProperty(
					object,
					"LocalTransparencyModifier"
				)

				object.LocalTransparencyModifier = 1
			end
		end

		if object:IsA("BillboardGui")
			or object:IsA("SurfaceGui") then

			saveProperty(object, "Enabled")
			object.Enabled = false
		end
	end
end

--==================================================
-- ОПТИМИЗАЦИЯ EXTREME
--==================================================

local function extremeOptimization()

	ultraOptimization()

	for _, object in ipairs(workspace:GetDescendants()) do

		if object:IsA("BasePart") then

			local size = object.Size

			local smallest =
				math.min(
					size.X,
					size.Y,
					size.Z
				)

			local volume =
				size.X *
				size.Y *
				size.Z

			if smallest <= 0.35
				or volume <= 0.06 then

				saveProperty(
					object,
					"LocalTransparencyModifier"
				)

				object.LocalTransparencyModifier = 1
			end
		end

		if object:IsA("MeshPart") then

			pcall(function()

				saveProperty(
					object,
					"RenderFidelity"
				)

				object.RenderFidelity =
					Enum.RenderFidelity.Performance

			end)
		end
	end
end

